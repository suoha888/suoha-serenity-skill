{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suoha-serenity.local/schema/entity.schema.json",
  "title": "suoha-serenity Entity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entity_id",
    "label",
    "entity_type",
    "access_level",
    "source_partition",
    "source_record_ids",
    "source_lineage",
    "review_status",
    "extraction_version"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2" },
    "entity_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "entity_type": { "type": "string", "minLength": 1 },
    "access_level": {
      "type": "string",
      "enum": ["public", "subscription", "private", "synthetic"]
    },
    "source_partition": {
      "type": "string",
      "enum": ["public", "subscription", "private", "synthetic"]
    },
    "source_record_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "source_lineage": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "review_status": {
      "type": "string",
      "enum": ["pending", "human_reviewed", "rejected"]
    },
    "extraction_version": { "type": "string", "minLength": 1 }
  }
}
