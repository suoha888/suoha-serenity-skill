{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suoha-serenity.local/schema/relation.schema.json",
  "title": "suoha-serenity Relation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "relation_id",
    "source_id",
    "relation_type",
    "target_id",
    "as_of",
    "access_level",
    "source_partition",
    "source_record_ids",
    "source_lineage",
    "review_status",
    "extraction_version"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2" },
    "relation_id": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "relation_type": {
      "type": "string",
      "enum": ["mentions", "reply_to", "quotes", "same_context", "candidate_edge"]
    },
    "target_id": { "type": "string", "minLength": 1 },
    "as_of": { "type": ["string", "null"], "format": "date-time" },
    "access_level": {
      "type": "string",
      "enum": ["public", "subscription", "private", "synthetic"]
    },
    "source_partition": {
      "type": "string",
      "enum": ["public", "subscription", "private", "synthetic"]
    },
    "source_record_ids": { "type": "array", "items": { "type": "string" } },
    "source_lineage": { "type": "array", "minItems": 1 },
    "review_status": {
      "type": "string",
      "enum": ["pending", "human_reviewed", "rejected"]
    },
    "extraction_version": { "type": "string", "minLength": 1 }
  }
}
