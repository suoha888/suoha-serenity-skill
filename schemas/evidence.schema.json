{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suoha-serenity.local/schema/evidence.schema.json",
  "title": "suoha-serenity Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "source",
    "source_type",
    "published_at",
    "captured_at",
    "known_at",
    "content_hash",
    "provenance",
    "access_level",
    "source_partition",
    "evidence_grade",
    "independence_group",
    "review_status"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2" },
    "evidence_id": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "source_type": {
      "type": "string",
      "enum": [
        "filing",
        "exchange_filing",
        "company_ir",
        "transcript",
        "regulator",
        "standard",
        "trade_press",
        "social_post",
        "local_archive",
        "other"
      ]
    },
    "content": { "type": "string" },
    "excerpt": { "type": "string" },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "captured_at": { "type": ["string", "null"], "format": "date-time" },
    "known_at": { "type": ["string", "null"], "format": "date-time" },
    "valid_from": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "valid_to": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "locator": { "type": "string" },
    "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "locator", "extraction_version"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "extraction_version": { "type": "string", "minLength": 1 },
        "human_reviewed": { "type": "boolean" }
      }
    },
    "access_level": {
      "type": "string",
      "enum": ["public", "subscription", "private", "synthetic"]
    },
    "source_partition": {
      "type": "string",
      "enum": ["public", "subscription", "private", "synthetic"]
    },
    "source_record_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "source_lineage": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    },
    "evidence_grade": {
      "type": "string",
      "enum": ["primary", "strong_secondary", "secondary", "lead", "unverified"]
    },
    "primary_or_secondary": {
      "type": "string",
      "enum": ["primary", "secondary", "unknown"]
    },
    "independence_group": { "type": "string", "minLength": 1 },
    "supports_claim_ids": { "type": "array", "items": { "type": "string" } },
    "contradicts_claim_ids": { "type": "array", "items": { "type": "string" } },
    "review_status": {
      "type": "string",
      "enum": ["pending", "human_reviewed", "rejected"]
    },
    "metadata": { "type": "object" }
  }
}
