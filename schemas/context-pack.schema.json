{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suoha-serenity.local/schema/context-pack.schema.json",
  "title": "suoha-serenity Context Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "context_id",
    "root_post_id",
    "conversation_id",
    "record_ids",
    "records",
    "context_completeness",
    "max_source_created_at",
    "access_level",
    "source_partition",
    "source_lineage",
    "extraction_version"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2" },
    "context_id": { "type": "string", "minLength": 1 },
    "root_post_id": { "type": "string", "minLength": 1 },
    "conversation_id": { "type": ["string", "null"] },
    "record_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "records": { "type": "array", "minItems": 1 },
    "context_completeness": {
      "type": "string",
      "enum": ["complete", "partial", "missing"]
    },
    "context_missing": { "type": "boolean" },
    "media_refs": { "type": "array", "items": { "type": "object" } },
    "max_source_created_at": { "type": ["string", "null"], "format": "date-time" },
    "access_level": {
      "type": "string",
      "enum": ["public", "subscription", "private", "synthetic"]
    },
    "source_partition": {
      "type": "string",
      "enum": ["public", "subscription", "private", "synthetic"]
    },
    "source_lineage": { "type": "array", "minItems": 1 },
    "extraction_version": { "type": "string", "minLength": 1 }
  }
}
