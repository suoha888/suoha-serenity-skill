{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suoha-serenity.local/schema/bottleneck-assessment.schema.json",
  "title": "suoha-serenity BottleneckAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bottleneck_id",
    "topic",
    "layer",
    "constraint_type",
    "physical_mechanism",
    "assessment_as_of",
    "research_cutoff",
    "dimensions",
    "capacity_states",
    "supply_chain_edges",
    "economic_capture_hypothesis",
    "evidence_ids",
    "counterevidence_ids",
    "access_level",
    "source_partition",
    "source_lineage",
    "review_status",
    "extraction_version"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "4" },
    "bottleneck_id": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "minLength": 1 },
    "layer": { "type": "string", "minLength": 1 },
    "constraint_type": {
      "type": "string",
      "enum": [
        "capacity",
        "qualification",
        "process_yield",
        "material",
        "equipment",
        "infrastructure",
        "regulatory",
        "integration",
        "supplier_concentration",
        "other"
      ]
    },
    "physical_mechanism": { "type": "string", "minLength": 1 },
    "demand_trigger": { "type": "string" },
    "assessment_as_of": { "type": "string", "format": "date-time" },
    "research_cutoff": { "type": "string", "format": "date-time" },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "status",
          "assessment",
          "epistemic_type",
          "evidence_ids",
          "confidence"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "enum": [
              "supplier_concentration",
              "substitutability",
              "qualification_burden",
              "expansion_lead_time",
              "customer_urgency",
              "capacity_visibility",
              "pricing_power",
              "economic_value_capture",
              "architecture_necessity",
              "yield_manufacturability",
              "merchant_vs_captive_capacity",
              "geographic_regulatory_concentration",
              "capital_intensity"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "unknown",
              "not_established",
              "contradicted"
            ]
          },
          "assessment": { "type": "string", "minLength": 1 },
          "value": { "type": ["number", "string", "null"] },
          "unit": { "type": "string" },
          "as_of": { "type": ["string", "null"], "format": "date-time" },
          "epistemic_type": {
            "type": "string",
            "enum": ["fact", "inference", "hypothesis", "unknown"]
          },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "unknowns": { "type": "array", "items": { "type": "string" } },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          }
        }
      }
    },
    "capacity_states": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "value",
          "unit",
          "as_of",
          "epistemic_type",
          "evidence_ids",
          "unknowns"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "nominal",
              "installed",
              "usable",
              "qualified",
              "merchant",
              "captive",
              "available"
            ]
          },
          "value": { "type": ["number", "string", "null"] },
          "unit": { "type": "string", "minLength": 1 },
          "as_of": { "type": ["string", "null"], "format": "date-time" },
          "epistemic_type": {
            "type": "string",
            "enum": ["fact", "inference", "hypothesis", "unknown"]
          },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "unknowns": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "supply_chain_edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id",
          "upstream_entity",
          "downstream_entity",
          "product_or_process",
          "relationship_type",
          "relationship_status",
          "as_of",
          "epistemic_type",
          "evidence_state",
          "evidence_ids",
          "counterevidence_ids",
          "alternatives",
          "unknowns",
          "confidence"
        ],
        "properties": {
          "edge_id": { "type": "string", "minLength": 1 },
          "upstream_entity": { "type": "string", "minLength": 1 },
          "downstream_entity": { "type": "string", "minLength": 1 },
          "product_or_process": { "type": "string", "minLength": 1 },
          "relationship_type": {
            "type": "string",
            "enum": [
              "supplies",
              "design_in",
              "qualifies",
              "reserves_capacity",
              "contracts_with",
              "depends_on",
              "alternative_to",
              "integrates"
            ]
          },
          "relationship_status": {
            "type": "string",
            "enum": ["reported", "inferred", "hypothesis", "unknown"]
          },
          "effective_from": { "type": ["string", "null"], "format": "date-time" },
          "effective_to": { "type": ["string", "null"], "format": "date-time" },
          "as_of": { "type": "string", "format": "date-time" },
          "epistemic_type": {
            "type": "string",
            "enum": ["fact", "inference", "hypothesis", "unknown"]
          },
          "evidence_state": {
            "type": "string",
            "enum": ["supported", "stale", "contradicted", "not_established"]
          },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "counterevidence_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "alternatives": { "type": "array", "items": { "type": "string" } },
          "unknowns": { "type": "array", "items": { "type": "string" } },
          "confidence": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "notes": { "type": "string" }
        }
      }
    },
    "economic_capture_hypothesis": { "type": "string", "minLength": 1 },
    "capture_path": { "type": "array", "items": { "type": "string" } },
    "candidate_company_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "counterevidence_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "access_level": {
      "type": "string",
      "enum": ["public", "subscription", "private", "synthetic"]
    },
    "source_partition": {
      "type": "string",
      "enum": ["public", "subscription", "private", "synthetic"]
    },
    "source_lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_partition",
          "source_record_id",
          "source_locator",
          "content_hash"
        ],
        "properties": {
          "source_partition": { "type": "string", "minLength": 1 },
          "source_record_id": { "type": "string", "minLength": 1 },
          "source_locator": { "type": "string", "minLength": 1 },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "published_at": { "type": ["string", "null"], "format": "date-time" },
          "known_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "review_status": {
      "type": "string",
      "enum": ["pending", "human_reviewed", "rejected"]
    },
    "extraction_version": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  }
}
