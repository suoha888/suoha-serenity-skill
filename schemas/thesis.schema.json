{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suoha-serenity.local/schema/thesis.schema.json",
  "title": "suoha-serenity Thesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "thesis_id",
    "statement",
    "causal_chain",
    "bottleneck",
    "assumptions",
    "failure_conditions",
    "state",
    "confidence",
    "opened_at",
    "last_updated_at",
    "access_level",
    "source_partition",
    "source_record_ids",
    "source_lineage",
    "review_status",
    "extraction_version"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2" },
    "thesis_id": { "type": "string", "minLength": 1 },
    "topic": { "type": "string" },
    "statement": { "type": "string", "minLength": 1 },
    "causal_chain": { "type": "array", "items": { "type": "string" } },
    "bottleneck": { "type": "string" },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "failure_conditions": { "type": "array", "items": { "type": "string" } },
    "state": {
      "type": "string",
      "enum": [
        "candidate",
        "forming",
        "supported",
        "high_conviction",
        "weakened",
        "revised",
        "invalidated",
        "closed"
      ]
    },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "opened_at": { "type": ["string", "null"], "format": "date-time" },
    "last_updated_at": { "type": ["string", "null"], "format": "date-time" },
    "access_level": {
      "type": "string",
      "enum": ["public", "subscription", "private", "synthetic"]
    },
    "source_partition": {
      "type": "string",
      "enum": ["public", "subscription", "private", "synthetic"]
    },
    "source_record_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "source_lineage": { "type": "array", "minItems": 1 },
    "review_status": {
      "type": "string",
      "enum": ["pending", "human_reviewed", "rejected"]
    },
    "extraction_version": { "type": "string", "minLength": 1 }
  }
}
