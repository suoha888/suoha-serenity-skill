{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://suoha-serenity.local/schema/thesis-event.schema.json",
  "title": "suoha-serenity Thesis Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "thesis_id",
    "event_type",
    "event_at",
    "known_at",
    "claim_ids",
    "evidence_ids",
    "before",
    "after",
    "access_level",
    "source_partition",
    "source_record_ids",
    "source_lineage",
    "review_status",
    "extraction_version"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2" },
    "event_id": { "type": "string", "minLength": 1 },
    "thesis_id": { "type": "string", "minLength": 1 },
    "event_type": {
      "type": "string",
      "enum": [
        "establish",
        "reinforce",
        "weaken",
        "revise",
        "reverse",
        "invalidate",
        "close",
        "reopen",
        "risk_added",
        "catalyst_failed"
      ]
    },
    "event_at": { "type": ["string", "null"], "format": "date-time" },
    "known_at": { "type": ["string", "null"], "format": "date-time" },
    "claim_ids": { "type": "array", "items": { "type": "string" } },
    "evidence_ids": { "type": "array", "items": { "type": "string" } },
    "before": { "type": "string" },
    "after": { "type": "string" },
    "reason": { "type": "string" },
    "access_level": {
      "type": "string",
      "enum": ["public", "subscription", "private", "synthetic"]
    },
    "source_partition": {
      "type": "string",
      "enum": ["public", "subscription", "private", "synthetic"]
    },
    "source_record_ids": { "type": "array", "items": { "type": "string" } },
    "source_lineage": { "type": "array", "minItems": 1 },
    "review_status": {
      "type": "string",
      "enum": ["pending", "human_reviewed", "rejected"]
    },
    "extraction_version": { "type": "string", "minLength": 1 }
  }
}
